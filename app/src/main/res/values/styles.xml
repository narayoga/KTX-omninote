<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Gaya teks. Dipakai dengan android:textAppearance="@style/..." -->
    <style name="TextAppearance.Omni.Headline" parent="TextAppearance.AppCompat">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Omni.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Omni.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Omni.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Omni.NavLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/nav_inactive</item>
    </style>

    <!-- Teks di atas header warna gelap -->
    <style name="TextAppearance.Omni.HeaderTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/header_text</item>
    </style>

    <style name="TextAppearance.Omni.HeaderSubtitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/header_text</item>
        <item name="android:alpha">0.8</item>
    </style>

    <!-- Bentuk bulat untuk tombol + di tengah bottom bar -->
    <style name="ShapeAppearance.Omni.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
